FROM quay.io/fedora/fedora-bootc:45

ARG KRISOS_PAYLOAD_REF

# Fedora 45 Anaconda runtime for the recommended bootc-generic-iso image type.
# The exact validated KrisOS payload reference is written into Anaconda's
# interactive defaults and embedded into the final ISO.
RUN dnf install -qy --setopt=install_weak_deps=False \
    anaconda \
    anaconda-install-env-deps \
    anaconda-install-img-deps \
    anaconda-dracut \
    dracut-config-generic \
    dracut-network \
    net-tools \
    squashfs-tools \
    grub2-efi-x64-cdboot \
    python3-mako \
    lorax-templates-generic \
    biosdevname \
    prefixdevname \
    xorriso \
    isomd5sum \
    && dnf clean all

# Fedora 43+ bootc installer images need the EFI tree materialized here.
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# Lorax creates links below /mnt that point into /var/mnt.
RUN mkdir -p /var/mnt

# Keep KrisOS branding/boot metadata separate from the payload selection.
RUN mkdir -p /usr/lib/image-builder/bootc
COPY iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# Interactive defaults only: preselect payload and localization, never
# partitioning, credentials, completion actions or unattended mode.
RUN test -n "$KRISOS_PAYLOAD_REF" && \
    printf '%s\n' \
    'graphical' \
    'lang it_IT.UTF-8' \
    'keyboard --vckeymap=it --xlayouts=it' \
    'timezone Europe/Rome --utc' \
    "bootc --source-imgref=registry:$KRISOS_PAYLOAD_REF --target-imgref=$KRISOS_PAYLOAD_REF" \
    > /usr/share/anaconda/interactive-defaults.ks && \
    ! grep -Eq '^[[:space:]]*(clearpart|autopart|part|partition|logvol|volgroup|user|rootpw|reboot|shutdown)([[:space:]]|$)' \
      /usr/share/anaconda/interactive-defaults.ks

RUN bootc container lint
