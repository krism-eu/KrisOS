FROM quay.io/fedora/fedora-bootc:45

# Fedora 45 Anaconda runtime for a generic bootc installer ISO.
# The installer ISO is intentionally independent from the KrisOS payload.
RUN dnf install -qy --setopt=install_weak_deps=False \
    anaconda \
    anaconda-install-img-deps \
    anaconda-dracut \
    dracut-config-generic \
    dracut-network \
    net-tools \
    grub2-efi-x64-cdboot \
    plymouth \
    default-fonts-core-sans \
    default-fonts-other-sans \
    google-noto-sans-cjk-fonts \
    xorriso \
    squashfs-tools && \
    dnf clean all

# image-builder expects the EFI tree here.
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# ISO metadata and conservative boot arguments.
# inst.wait_for_disks=0 removes Anaconda's extra wait; inst.noibft avoids iBFT
# probing. Generic block/device discovery remains enabled until F45 is measured
# on the physical validation machine. Keep configuration as normal source files
# so the build is independent from Dockerfile heredoc parser support.
RUN mkdir -p /usr/lib/image-builder/bootc
COPY iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# Interactive defaults only. The bootc source is deliberately NOT embedded in
# the ISO. Supply it through a Kickstart selected at boot with inst.ks=https://...
# so the same installer ISO can install any chosen KrisOS tag or digest.
RUN printf '%s\n' \
    'graphical' \
    'lang it_IT.UTF-8' \
    'keyboard --vckeymap=it --xlayouts=it' \
    'timezone Europe/Rome --utc' \
    'selinux --enforcing' \
    > /usr/share/anaconda/interactive-defaults.ks

# Minimal lorax-equivalent setup required by the generic ISO path.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

# Replace the normal getty template with Anaconda's shell template. Explicitly
# remove any existing unit first: Fedora base-image state must not decide whether
# this build succeeds.
RUN rm -f /usr/lib/systemd/system/autovt@.service && \
    ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

RUN mkdir -p /usr/lib/systemd/logind.conf.d
COPY anaconda-shell.conf /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

# /root is a symlink into /var on bootc/OSTree systems and its target can be
# absent during an OCI build. dracut needs the resolved directory to exist.
RUN mkdir -p "$(realpath /root)" && \
    kernel="$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version')" && \
    test -n "${kernel}" && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
        --add "anaconda" \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

# Anaconda runs as root in the live environment; allow its PipeWire session.
RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d && \
    printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.service.d/allowroot.conf && \
    printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.socket.d/allowroot.conf

RUN bootc container lint
